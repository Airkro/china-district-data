{
  "name": "china-district-data",
  "version": "6.0.0",
  "description": "中华人民共和国行政区划编码数据",
  "license": "MIT",
  "author": {
    "name": "Eric Chen"
  },
  "keywords": [
    "china",
    "city",
    "district",
    "province"
  ],
  "homepage": "https://github.com/Airkro/china-district-data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Airkro/china-district-data.git"
  },
  "bugs": {
    "url": "https://github.com/Airkro/china-district-data/issues"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "generate": "node --env-file=.env config/index.mts",
    "lint:eslint": "eslint . --quiet --fix --concurrency=auto",
    "lint:staged": "nice-move lint staged",
    "lint:type": "tsc -p tsconfig.json",
    "prepare": "nice-move git hooks",
    "prepublishOnly": "pnpm run lint:staged && pnpm run lint:type && pnpm test",
    "snapshot": "ava --fail-fast -u",
    "test": "ava --fail-fast"
  },
  "devDependencies": {
    "@bring-it/cli": "^0.11.1",
    "@bring-it/npm": "^0.9.3",
    "@nice-move/all-in-base": "^0.6.34",
    "ava": "^6.4.1",
    "eslint": "^9.39.2",
    "fs-chain": "^12.0.0",
    "garou": "^0.9.17",
    "prettier": "~3.8.1",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.16.0",
    "pnpm": "^10.28.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "ava": {
    "extensions": [
      "mts",
      "mjs"
    ]
  },
  "prettier": "@nice-move/prettier-config"
}
